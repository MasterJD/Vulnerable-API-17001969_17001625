{
  "name": "vulnerable-node-source",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "report:complexity": "node scripts/generate-complexity-report.js",
    "report:governance": "node scripts/generate-governance-log.js",
    "report": "npm run report:complexity && npm run report:governance",
    "ci": "npm run lint && npm test && npm run report",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall-security.js",
    "security:sbom": "trivy fs --format cyclonedx -o security/sbom.json .",
    "security:scan": "trivy fs --scanners vuln --format table .",
    "security:scan:json": "trivy fs --scanners vuln --format json -o security/reports/vuln-latest.json .",
    "security:update": "node scripts/postinstall-security.js"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.17.3",
    "log4js": "^6.9.1",
    "morgan": "^1.10.0",
    "pg-promise": "^11.5.4",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
