<div class="max-w-5xl mx-auto">
    <div class="hero bg-base-100 rounded-box mb-6 py-8">
        <div class="hero-content text-center">
            <div class="max-w-xl">
                <h1 class="text-3xl font-bold">Admin - Add Product</h1>
                <p class="py-3 opacity-70">Create a new product to publish it in the main catalog.</p>
            </div>
        </div>
    </div>

    <% if (message) { %>
        <div class="alert <%= messageType === 'success' ? 'alert-success' : 'alert-error' %> shadow mb-6">
            <span><%- message %></span>
        </div>
    <% } %>

    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <form method="post" action="/admin/products" class="space-y-4" enctype="multipart/form-data">
                <div class="form-control w-full">
                    <label class="label" for="name"><span class="label-text">Product name</span></label>
                    <input type="text" id="name" name="name" class="input input-bordered w-full" value="<%- values.name %>" required>
                </div>

                <div class="form-control w-full">
                    <label class="label" for="description"><span class="label-text">Description</span></label>
                    <textarea id="description" name="description" class="textarea textarea-bordered w-full h-28" required><%- values.description %></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control w-full">
                        <label class="label" for="price"><span class="label-text">Price (EUR)</span></label>
                        <input type="number" min="0" step="1" id="price" name="price" class="input input-bordered w-full" value="<%- values.price %>" required>
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="image_file"><span class="label-text">Upload image</span></label>
                        <input type="file" id="image_file" name="image_file" class="file-input file-input-bordered w-full" accept="image/png,image/jpeg,image/gif,image/webp">
                    </div>
                </div>

                <div class="form-control w-full">
                    <label class="label" for="image"><span class="label-text">Or existing image filename</span></label>
                    <input type="text" id="image" name="image" class="input input-bordered w-full" value="<%- values.image %>" placeholder="product_1.jpg">
                </div>

                <div class="text-sm opacity-70">
                    You can upload your own image, or use an existing one: product_1.jpg, product_2.jpg, product_3.jpg, product_4.jpg, product_5.jpg, product_6.jpg, product_7.jpg, product_8.jpg.
                </div>

                <div class="card-actions justify-end pt-2">
                    <a href="/" class="btn btn-ghost">Back</a>
                    <button type="submit" class="btn btn-primary">Create product</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card bg-base-100 shadow-xl mt-6">
        <div class="card-body">
            <h2 class="card-title">Current products</h2>

            <% if (!products || products.length === 0) { %>
                <div class="alert alert-info mt-3">
                    <span>No products available.</span>
                </div>
            <% } else { %>
                <div class="overflow-x-auto mt-3">
                    <table class="table table-zebra">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (var i = 0; i < products.length; i++) { %>
                                <tr>
                                    <td><%- products[i].id %></td>
                                    <td>
                                        <img src="/images/<%- products[i].image %>" alt="<%- products[i].name %>" class="w-16 h-16 rounded object-cover" />
                                    </td>
                                    <td><%- products[i].name %></td>
                                    <td><%- products[i].price %>€</td>
                                    <td>
                                        <form method="post" action="/admin/products/delete" onsubmit="return confirm('Delete this product?')">
                                            <input type="hidden" name="product_id" value="<%- products[i].id %>">
                                            <button type="submit" class="btn btn-error btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
