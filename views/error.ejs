<div class="flex flex-col items-center justify-center py-16">
    <div class="alert alert-error max-w-lg shadow-lg">
        <div>
            <h2 class="text-xl font-bold"><%= message %></h2>
            <p class="text-lg opacity-80">Status: <%= error.status %></p>
        </div>
    </div>
    <pre class="mt-6 p-4 bg-base-300 rounded-lg overflow-auto max-w-4xl w-full text-sm"><%= error.stack %></pre>
</div>