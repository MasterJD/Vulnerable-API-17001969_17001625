<div class="card w-96 bg-base-100 shadow-xl">
    <div class="card-body">
        <div class="flex justify-center mb-2">
            <img width="60" src="/images/logo.png" alt="logo">
        </div>
        <h2 class="text-center text-2xl font-bold mb-4">Sign In</h2>

        <form class="form-signin" method="post" action="/login/auth" enctype="application/x-www-form-urlencoded">
            <div class="form-control w-full mb-3">
                <label class="label" for="username"><span class="label-text">Username</span></label>
                <input type="text" id="username" name="username" placeholder="User name…" class="input input-bordered w-full" required autofocus>
            </div>

            <div class="form-control w-full mb-4">
                <label class="label" for="password"><span class="label-text">Password</span></label>
                <input type="password" id="password" name="password" placeholder="Password…" class="input input-bordered w-full" required>
            </div>

            <input type="hidden" id="returnurl" name="returnurl" value="<%-returnurl%>">

            <button class="btn btn-primary w-full" type="submit">Sign In</button>

            <% if (auth_error != undefined) { %>
            <div class="alert alert-error mt-4 text-sm">
                <span><%-auth_error%></span>
            </div>
            <% } %>

            <div class="divider"></div>

            <div class="text-sm opacity-60">
                <p class="font-bold mb-1">Demo Users:</p>
                <p>admin : admin</p>
                <p>roberto : asdfpiuw981</p>
            </div>
        </form>
    </div>
</div>