<div class="max-w-4xl mx-auto">
    <div class="card lg:card-side bg-base-100 shadow-xl">
        <figure class="lg:w-1/2">
            <img src="/images/<%- product.image %>" alt="<%- product.name %>" class="w-full h-80 lg:h-full object-cover" />
        </figure>
        <div class="card-body lg:w-1/2">
            <h2 class="card-title text-3xl"><%- product.name %></h2>
            <p class="opacity-70 flex-grow"><%- product.description %></p>
            <div class="text-3xl font-bold text-primary mt-2"><%- product.price %> €</div>
            <div class="card-actions justify-between mt-6">
                <a class="btn btn-outline" href="/">&larr; Go Back</a>
                <button id="buy_button" class="btn btn-success gap-2">
                    Buy
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Buy Modal -->
<dialog id="buy-dialog" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Confirm product &amp; details</h3>
        <form id="buy-form" enctype="application/x-www-form-urlencoded">
            <div class="form-control w-full mb-3">
                <label class="label" for="mail"><span class="label-text">Contact mail</span></label>
                <input type="email" class="input input-bordered w-full" name="mail" id="mail" placeholder="Email" required>
            </div>
            <div class="form-control w-full mb-3">
                <label class="label" for="address"><span class="label-text">Shipping Address</span></label>
                <input type="text" class="input input-bordered w-full" name="address" id="address" placeholder="Shipping address…" required>
            </div>
            <div class="form-control w-full mb-3">
                <label class="label" for="ship_date"><span class="label-text">Shipping date</span></label>
                <input type="date" class="input input-bordered w-full" name="ship_date" id="ship_date" required>
            </div>
            <div class="form-control w-full mb-3">
                <label class="label" for="phone"><span class="label-text">Contact phone</span></label>
                <input type="tel" class="input input-bordered w-full" name="phone" id="phone" placeholder="Contact phone…" required>
            </div>
            <div class="form-control w-full mb-3">
                <label class="label" for="price"><span class="label-text">Product price</span></label>
                <input type="text" class="input input-bordered w-full" name="price" id="price" value="<%- product.price %>€" readonly>
            </div>
            <input type="hidden" name="product_id" id="product_id" value="<%- product.id %>">
            <input type="hidden" name="product_name" id="product_name" value="<%- product.name %>">
            <div class="modal-action">
                <span id="error" class="text-error hidden"></span>
                <button type="button" class="btn btn-error" onclick="document.getElementById('buy-dialog').close()">Cancel</button>
                <button type="submit" class="btn btn-success gap-2">
                    Buy
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<!-- Success Modal -->
<dialog id="success-dialog" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg" id="success-message"></h3>
        <div class="modal-action">
            <button class="btn btn-success" onclick="document.getElementById('success-dialog').close()">Ok</button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>