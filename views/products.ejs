<div class="hero bg-base-100 rounded-box mb-8 py-10">
    <div class="hero-content text-center">
        <div class="max-w-xl">
            <h1 class="text-4xl font-bold">Welcome to NodeVulnerable!</h1>
            <p class="py-4 opacity-70">The application to test vulnerability code analyzers. Browse our product catalog below.</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="grid">
    <% for(var i = 0; i < products.length; i++) {
        var product = products[i];
        var searchableProductText = (product.name + ' ' + product.description).toLowerCase();
        var productPrice = product.price + '€';
        var productImageSrc = (/^https?:\/\//i.test(product.image || '')) ? product.image : '/images/' + product.image;
    %>
    <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow duration-200" data-product-card="true" data-product-search="<%- searchableProductText %>">
        <figure class="px-4 pt-4">
            <img src="<%- productImageSrc %>" alt="<%-product.name%>" class="rounded-xl h-48 w-full object-cover" />
        </figure>
        <div class="card-body">
            <h2 class="card-title text-base">
                <span><%-product.name%></span>
            </h2>
            <p class="text-sm opacity-70 line-clamp-2"><%-product.description%></p>
            <div class="card-actions justify-between mt-2">
                <div class="badge badge-primary badge-lg font-semibold"><%-product.price%>€</div>
                <button
                    type="button"
                    class="btn btn-success btn-sm gap-2"
                    data-buy-button="true"
                    data-product-id="<%- product.id %>"
                    data-product-name="<%- product.name %>"
                    data-product-price="<%- productPrice %>">
                    Buy
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
    <% } %>
</div>

<div id="filter-empty-state" class="alert alert-warning shadow-lg mt-6 hidden">
    <span>No products match your search.</span>
</div>

<dialog id="cart-dialog" class="modal">
    <div class="modal-box max-w-3xl">
        <h3 class="font-bold text-lg mb-4">Cart and checkout</h3>

        <div role="tablist" class="tabs tabs-boxed mb-4">
            <button type="button" id="cart-tab-products" class="tab tab-active">Products</button>
            <button type="button" id="cart-tab-checkout" class="tab">Your info</button>
        </div>

        <div id="cart-panel-products">
            <div id="cart-empty-state" class="alert alert-info shadow mb-4 hidden">
                <span>Your cart is empty. Add products from the grid first.</span>
            </div>

            <div id="cart-items-list" class="space-y-3"></div>

            <div class="flex items-center justify-between mt-4">
                <button type="button" id="clear-cart" class="btn btn-ghost btn-sm">Clear cart</button>
                <div class="text-lg font-semibold">Total: <span id="cart-total">0€</span></div>
            </div>

            <div class="modal-action mt-4">
                <button type="button" class="btn" onclick="document.getElementById('cart-dialog').close()">Close</button>
                <button type="button" id="go-to-checkout" class="btn btn-primary">Continue</button>
            </div>
        </div>

        <div id="cart-panel-checkout" class="hidden">
            <form id="cart-checkout-form" enctype="application/x-www-form-urlencoded">
                <div class="form-control w-full mb-3">
                    <label class="label" for="checkout-mail"><span class="label-text">Contact mail</span></label>
                    <input type="email" class="input input-bordered w-full" name="mail" id="checkout-mail" placeholder="Email" required>
                </div>
                <div class="form-control w-full mb-3">
                    <label class="label" for="checkout-address"><span class="label-text">Shipping Address</span></label>
                    <input type="text" class="input input-bordered w-full" name="address" id="checkout-address" placeholder="Shipping address..." required>
                </div>
                <div class="form-control w-full mb-3">
                    <label class="label" for="checkout-ship-date"><span class="label-text">Shipping date</span></label>
                    <input type="date" class="input input-bordered w-full" name="ship_date" id="checkout-ship-date" required>
                </div>
                <div class="form-control w-full mb-3">
                    <label class="label" for="checkout-phone"><span class="label-text">Contact phone</span></label>
                    <input type="tel" class="input input-bordered w-full" name="phone" id="checkout-phone" placeholder="Contact phone..." required>
                </div>
                <div class="form-control w-full mb-3">
                    <label class="label" for="checkout-total"><span class="label-text">Cart total</span></label>
                    <input type="text" class="input input-bordered w-full" id="checkout-total" readonly>
                </div>

                <div class="modal-action">
                    <span id="cart-error" class="text-error hidden"></span>
                    <button type="button" id="go-to-products" class="btn btn-ghost">Back to products</button>
                    <button type="submit" id="checkout-submit" class="btn btn-success gap-2">
                        Buy all
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<dialog id="success-dialog" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg" id="success-message"></h3>
        <div class="modal-action">
            <button class="btn btn-success" onclick="document.getElementById('success-dialog').close()">Ok</button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
